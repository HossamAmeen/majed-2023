# Copy to .env and adjust. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=Africa/Cairo
LOG_LEVEL=INFO

# SQLite database file (absolute path recommended in production).
DATABASE_URL=sqlite:///db.sqlite3
BACKUP_DIR=backups

# Vue frontend: used for CORS and for the password reset link in emails.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=

JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=12

# Celery (scheduled database backups).
REDIS_URL=redis://localhost:6379/0

# Email (password reset). Development prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Only for `python manage.py import_legacy_mysql` (one-time migration from Laravel).
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_USER=root
LEGACY_DB_PASSWORD=
LEGACY_DB_NAME=
